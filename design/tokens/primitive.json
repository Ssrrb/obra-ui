{
  "$schema": "https://dtcg.org/draft/specification/",
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "small": { "$type": "dimension", "$value": "2px" },
    "medium": { "$type": "dimension", "$value": "4px" },
    "round": { "$type": "dimension", "$value": "999px" }
  },
  "font": {
    "size": {
      "xs": { "$type": "dimension", "$value": "11px" },
      "sm": { "$type": "dimension", "$value": "13px" },
      "md": { "$type": "dimension", "$value": "14px" },
      "lg": { "$type": "dimension", "$value": "16px" }
    },
    "weight": {
      "regular": { "$type": "number", "$value": "400" },
      "medium": { "$type": "number", "$value": "500" },
      "bold": { "$type": "number", "$value": "600" }
    },
    "family": {
      "base": { "$type": "string", "$value": "var(--vscode-font-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif)" },
      "mono": { "$type": "string", "$value": "var(--vscode-editor-font-family, 'SF Mono', Menlo, Monaco, 'Courier New', monospace)" }
    }
  },
  "border": {
    "width": {
      "default": { "$type": "dimension", "$value": "1px" },
      "thick": { "$type": "dimension", "$value": "2px" }
    }
  },
  "opacity": {
    "disabled": { "$type": "number", "$value": "0.4" }
  },
  "color": {
    "transparent": { "$type": "color", "$value": "#00000000" },
    "mac": {
      "windowClose": { "$type": "color", "$value": "#ff5f57", "$description": "macOS window control — close. OS chrome, not a VS Code theme color; the same in every theme." },
      "windowMinimize": { "$type": "color", "$value": "#febc2e", "$description": "macOS window control — minimize. OS chrome, not a VS Code theme color." },
      "windowZoom": { "$type": "color", "$value": "#28c840", "$description": "macOS window control — zoom. OS chrome, not a VS Code theme color." }
    }
  }
}
