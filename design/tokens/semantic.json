{
  "$schema": "https://dtcg.org/draft/specification/",
  "surface": {
    "default": { "$type": "color", "$value": "{vscode.editor.background}", "$description": "Base canvas" },
    "raised": { "$type": "color", "$value": "{vscode.sideBar.background}", "$description": "Panels, cards" },
    "input": { "$type": "color", "$value": "{vscode.input.background}", "$description": "Text inputs" },
    "hover": { "$type": "color", "$value": "{vscode.list.hoverBackground}", "$description": "Row/item hover" },
    "selected": { "$type": "color", "$value": "{vscode.list.activeSelectionBackground}", "$description": "Active selection" }
  },
  "text": {
    "primary": { "$type": "color", "$value": "{vscode.foreground}" },
    "secondary": { "$type": "color", "$value": "{vscode.descriptionForeground}" },
    "onAction": { "$type": "color", "$value": "{vscode.button.foreground}" },
    "link": { "$type": "color", "$value": "{vscode.textLink.foreground}" },
    "linkActive": { "$type": "color", "$value": "{vscode.textLink.activeForeground}" },
    "danger": { "$type": "color", "$value": "{vscode.errorForeground}" }
  },
  "border": {
    "default": { "$type": "color", "$value": "{vscode.widget.border}" },
    "focus": { "$type": "color", "$value": "{vscode.focusBorder}" },
    "input": { "$type": "color", "$value": "{vscode.input.border}" },
    "contrast": { "$type": "color", "$value": "{vscode.contrastBorder}" }
  },
  "chrome": {
    "$description": "Workbench chrome regions (title bar, activity bar, side bar, tabs, panel, status bar). Preview and replica surfaces consume these; product content keeps the surface/text/action tokens.",
    "activityBar": {
      "background": { "$type": "color", "$value": "{vscode.activityBar.background}" },
      "foreground": { "$type": "color", "$value": "{vscode.activityBar.foreground}" },
      "inactiveForeground": { "$type": "color", "$value": "{vscode.activityBar.inactiveForeground}" },
      "border": { "$type": "color", "$value": "{vscode.activityBar.border}" },
      "activeBorder": { "$type": "color", "$value": "{vscode.activityBar.activeBorder}" }
    },
    "sideBar": {
      "background": { "$type": "color", "$value": "{vscode.workbench.sideBar.background}" },
      "border": { "$type": "color", "$value": "{vscode.workbench.sideBar.border}" }
    },
    "editor": {
      "background": { "$type": "color", "$value": "{vscode.workbench.editor.background}" }
    },
    "sectionHeader": {
      "background": { "$type": "color", "$value": "{vscode.sideBarSectionHeader.background}" },
      "foreground": { "$type": "color", "$value": "{vscode.sideBarSectionHeader.foreground}" },
      "border": { "$type": "color", "$value": "{vscode.sideBarSectionHeader.border}" }
    },
    "titleBar": {
      "background": { "$type": "color", "$value": "{vscode.titleBar.activeBackground}" },
      "foreground": { "$type": "color", "$value": "{vscode.titleBar.activeForeground}" },
      "border": { "$type": "color", "$value": "{vscode.titleBar.border}" }
    },
    "statusBar": {
      "background": { "$type": "color", "$value": "{vscode.statusBar.background}" },
      "foreground": { "$type": "color", "$value": "{vscode.statusBar.foreground}" },
      "border": { "$type": "color", "$value": "{vscode.statusBar.border}" }
    },
    "tabs": {
      "background": { "$type": "color", "$value": "{vscode.editorGroupHeader.tabsBackground}" },
      "border": { "$type": "color", "$value": "{vscode.editorGroupHeader.border}" },
      "tabBorder": { "$type": "color", "$value": "{vscode.tab.border}" },
      "hoverBackground": { "$type": "color", "$value": "{vscode.tab.hoverBackground}" },
      "activeBackground": { "$type": "color", "$value": "{vscode.tab.activeBackground}" },
      "activeForeground": { "$type": "color", "$value": "{vscode.tab.activeForeground}" },
      "activeBorderTop": { "$type": "color", "$value": "{vscode.tab.activeBorderTop}" },
      "inactiveBackground": { "$type": "color", "$value": "{vscode.tab.inactiveBackground}" },
      "inactiveForeground": { "$type": "color", "$value": "{vscode.tab.inactiveForeground}" }
    },
    "panel": {
      "background": { "$type": "color", "$value": "{vscode.panel.background}" },
      "border": { "$type": "color", "$value": "{vscode.panel.border}" },
      "titleActiveForeground": { "$type": "color", "$value": "{vscode.panel.titleActiveForeground}" },
      "titleInactiveForeground": { "$type": "color", "$value": "{vscode.panel.titleInactiveForeground}" },
      "titleActiveBorder": { "$type": "color", "$value": "{vscode.panel.titleActiveBorder}" }
    },
    "breadcrumb": {
      "background": { "$type": "color", "$value": "{vscode.breadcrumb.background}" },
      "foreground": { "$type": "color", "$value": "{vscode.breadcrumb.foreground}" },
      "focusForeground": { "$type": "color", "$value": "{vscode.breadcrumb.focusForeground}" }
    },
    "selection": {
      "background": { "$type": "color", "$value": "{surface.selected}" },
      "foreground": { "$type": "color", "$value": "{vscode.list.activeSelectionForeground}" },
      "hoverBackground": { "$type": "color", "$value": "{surface.hover}" }
    },
    "scrollbar": {
      "slider": { "$type": "color", "$value": "{vscode.scrollbarSlider.background}" },
      "sliderHover": { "$type": "color", "$value": "{vscode.scrollbarSlider.hoverBackground}" },
      "sliderActive": { "$type": "color", "$value": "{vscode.scrollbarSlider.activeBackground}" }
    },
    "window": {
      "close": { "$type": "color", "$value": "{color.mac.windowClose}" },
      "minimize": { "$type": "color", "$value": "{color.mac.windowMinimize}" },
      "zoom": { "$type": "color", "$value": "{color.mac.windowZoom}" }
    }
  },
  "action": {
    "primary": {
      "background": { "$type": "color", "$value": "{vscode.button.background}" },
      "backgroundHover": { "$type": "color", "$value": "{vscode.button.hoverBackground}" },
      "foreground": { "$type": "color", "$value": "{vscode.button.foreground}" }
    },
    "secondary": {
      "background": { "$type": "color", "$value": "{vscode.button.secondaryBackground}" },
      "backgroundHover": { "$type": "color", "$value": "{vscode.button.secondaryHoverBackground}" },
      "foreground": { "$type": "color", "$value": "{vscode.button.secondaryForeground}" }
    }
  },
  "danger": {
    "background": { "$type": "color", "$value": "{vscode.inputValidation.errorBackground}" },
    "border": { "$type": "color", "$value": "{vscode.inputValidation.errorBorder}" }
  },
  "focus": {
    "ring": { "$type": "color", "$value": "{vscode.focusBorder}" }
  },
  "space": {
    "xs": { "$type": "dimension", "$value": "{space.1}" },
    "sm": { "$type": "dimension", "$value": "{space.2}" },
    "md": { "$type": "dimension", "$value": "{space.3}" },
    "lg": { "$type": "dimension", "$value": "{space.4}" },
    "xl": { "$type": "dimension", "$value": "{space.5}" }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "{radius.small}" },
    "surface": { "$type": "dimension", "$value": "{radius.medium}" }
  },
  "font": {
    "body": { "$type": "dimension", "$value": "{font.size.sm}" },
    "small": { "$type": "dimension", "$value": "{font.size.xs}" },
    "title": { "$type": "dimension", "$value": "{font.size.lg}" },
    "mono": { "$type": "string", "$value": "{font.family.mono}" }
  }
}
