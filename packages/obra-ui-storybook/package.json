  },
  "dependencies": {
    "@obra/ui": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-themes": "^8.6.14",
    "@storybook/web-components": "^8.6.14",
    "@storybook/web-components-vite": "^8.6.14",
    "axe-core": "^4.10.2",
    "playwright": "^1.50.1",
    "storybook": "^8.6.14",
    "typescript": "^5.6.0"
  }
}
