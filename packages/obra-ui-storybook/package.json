{
  "name": "@obra/ui-storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Storybook workbench for @obra/ui: every primitive, pattern, and layout in every state and theme. Fast feedback, never the merge gate (PRINCIPLES.md rule 10).",
  "scripts": {
