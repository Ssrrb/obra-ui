{
  "name": "obra-ui-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Obra Studio UI platform: rules, @obra/ui, tokens, stories.",
  "scripts": {
    "ui:tokens": "node scripts/build-tokens.mjs",
    "ui:tokens:check": "node scripts/build-tokens.mjs && node scripts/check-clean.mjs",
    "ui:build": "pnpm --filter @obra/ui build",
    "ui:test": "pnpm --filter @obra/ui test",
    "ui:storybook": "pnpm --filter @obra/ui-storybook storybook",
    "ui:a11y": "pnpm --filter @obra/ui-storybook a11y",
    "obra:launch": "node scripts/ui/launch-code.mjs",
    "ui:e2e": "node scripts/ui/run-flow.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
