    "test:a11y": "playwright test accessibility.spec.ts"
  },
  "dependencies": {
    "@obra/ui": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.10.0",
    "axe-core": "^4.10.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
