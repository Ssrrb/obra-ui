{
  "name": "@obra/ui-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VS Code webview harness for Obra Studio surfaces: mocked acquireVsCodeApi, deterministic fixtures, and Playwright screenshot diffs in Chromium. Fast feedback, never the merge gate (design/PRINCIPLES.md rule 10).",
